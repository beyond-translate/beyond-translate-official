---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import { purchaseConfig } from '@/config/purchase';
import { getPurchaseStrings } from '@/i18n/purchase';
import { assertPurchaseConfig } from '@/lib/purchase-guard';

import PurchaseClosed from './PurchaseClosed.astro';
import PurchaseOpen from './PurchaseOpen.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
assertPurchaseConfig(purchaseConfig, Astro.site?.origin);

const copy = getPurchaseStrings(lang);
const open = purchaseConfig.enabled;
const title = open ? copy.meta.title : copy.closed.title;
const description = open ? copy.meta.description : copy.closed.body;
// The purchase page is not ready for search engines until sales open.
const robots = open ? [] : [{ tag: 'meta' as const, attrs: { name: 'robots', content: 'noindex' } }];
---

<StarlightPage
  frontmatter={{
    title,
    description,
    template: 'splash',
    pagefind: false,
    head: robots,
  }}
  hasSidebar={false}
>
  <div class:list={['not-content', 'bt-purchase', { 'is-open': open }]}>
    {open ? <PurchaseOpen lang={lang} /> : <PurchaseClosed lang={lang} />}
  </div>
</StarlightPage>

<style>
  /* The page opens with its own hero; collapse Starlight's empty title band around the hidden title. */
  :global(html:has(.bt-purchase) .content-panel:has(> .sl-container > h1#_top)) {
    padding-block: 0;
  }

  :global(html:has(.bt-purchase) main h1#_top) {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .bt-purchase {
    padding-block: var(--bt-space-page-top) var(--bt-space-section);
  }

  /* The hero already provides its own top spacing once the page title is hidden. */
  .bt-purchase.is-open {
    padding-block-start: 0;
  }
</style>
