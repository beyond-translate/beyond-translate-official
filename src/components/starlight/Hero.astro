---
import { LinkButton } from '@astrojs/starlight/components';
import { Crown } from '@lucide/astro';

import ProductPreview from '@/components/landing/ProductPreview.astro';
import { purchaseConfig } from '@/config/purchase';
import { storeIds, storeLogos, storeUrls } from '@/config/stores';
import { getLanding } from '@/i18n/landing';
import { docsPath } from '@/i18n/languages';
import { getPurchaseStrings, localePath, purchasePath } from '@/i18n/purchase';
import { withBase } from '@/lib/url';

const { entry, lang: routeLang } = Astro.locals.starlightRoute;
// Starlight exposes the zh-hant locale as zh-TW so its built-in UI copy is Traditional Chinese.
const lang = routeLang === 'zh-TW' ? 'zh-Hant' : routeLang;
const { data } = entry;
const { title = data.title, tagline, actions = [] } = data.hero ?? {};
const copy = getLanding(lang);
const purchase = getPurchaseStrings(lang);
const purchaseOpen = purchaseConfig.enabled;
// With a purchase call to action on the page, the existing primary action becomes secondary.
const heroActions = purchaseOpen
  ? actions.map((action) => (action.variant === 'primary' ? { ...action, variant: 'secondary' as const } : action))
  : actions;

const actionHref = (link: string) => {
  if (link === 'help' || link.startsWith('help/')) return withBase(docsPath(lang, link));
  return /^(?:[a-z][a-z0-9+.-]*:|\/\/|#|\/)/i.test(link) ? withBase(link) : withBase(localePath(lang, link));
};

const stores = storeIds.map((id, index) => ({
  label: copy.release.browsers[index] ?? id,
  href: storeUrls[id],
  logo: withBase(storeLogos[id]),
}));
---

<section class="bt-hero" data-lang={lang} aria-labelledby="_top">
  <div class="bt-hero-copy">
    <p class="bt-eyebrow">
      <span class="bt-eyebrow-dot" aria-hidden="true"></span>
      {copy.eyebrow}
    </p>
    <h1 id="_top" data-page-title class="bt-hero-title" set:html={title} />
    {tagline && <p class="bt-hero-tagline" set:html={tagline} />}
    <div class="bt-hero-actions">
      {purchaseOpen && (
        <LinkButton href={withBase(purchasePath(lang))} variant="primary">
          {purchase.entry.heroCta}
          <Crown size="1.5rem" stroke-width={1.8} aria-hidden="true" />
        </LinkButton>
      )}
      {heroActions.map(({ text, link, variant, icon, attrs = {} }) => (
        <LinkButton href={actionHref(link)} variant={variant} icon={icon?.name} {...attrs}>
          {text}
          {icon?.html && <Fragment set:html={icon.html} />}
        </LinkButton>
      ))}
    </div>
    <div class="bt-hero-stores">
      <span class="bt-hero-stores-label">{copy.stores.label}</span>
      {stores.map((store) => (
        <a class="bt-hero-store" href={store.href} target="_blank" rel="noopener noreferrer">
          <img class="bt-hero-store-logo" src={store.logo} alt="" width="18" height="18" />
          {store.label}
        </a>
      ))}
    </div>
    <p class="bt-hero-status">
      <span class="bt-hero-status-dot" aria-hidden="true"></span>
      {copy.status}
    </p>
  </div>

  <ProductPreview lang={lang} class="bt-hero-preview" />
</section>

<style>
  .bt-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: var(--bt-space-page-top) var(--bt-space-section);
  }

  .bt-hero-copy {
    max-width: 39rem;
  }

  .bt-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    border: 1px solid var(--bt-border);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    background: color-mix(in oklab, var(--bt-surface) 70%, transparent);
    color: var(--bt-muted);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .bt-eyebrow-dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--bt-brand);
    box-shadow: 0 0 0 4px var(--bt-brand-soft);
  }

  .bt-hero-title {
    margin: 1.35rem 0 0;
    color: var(--bt-ink);
    font-size: clamp(2.6rem, 5.4vw, 4.7rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .bt-hero-tagline {
    max-width: 36rem;
    margin: 1.5rem 0 0;
    color: var(--bt-muted);
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.75;
    text-wrap: balance;
  }

  .bt-hero[data-lang='en'] .bt-hero-title {
    font-size: clamp(2.15rem, 5vw, 4.7rem);
  }

  .bt-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .bt-hero-actions :global(.sl-link-button) {
    margin: 0;
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .bt-hero-stores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.65rem;
    margin-top: 1.15rem;
  }

  .bt-hero-stores-label {
    color: var(--bt-faint);
    font-size: 0.76rem;
    letter-spacing: 0.01em;
  }

  .bt-hero-store {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    border: 1px solid var(--bt-border);
    border-radius: 999px;
    padding: 0.26rem 0.7rem 0.26rem 0.5rem;
    background: color-mix(in oklab, var(--bt-surface) 70%, transparent);
    color: var(--bt-muted);
    font-size: 0.78rem;
    font-weight: 500;
    line-height: 1.4;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease;
  }

  .bt-hero-store:hover {
    border-color: var(--bt-brand);
    background: var(--bt-brand-soft);
    color: var(--bt-ink);
  }

  .bt-hero-store-logo {
    display: block;
    width: 1.05rem;
    height: 1.05rem;
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    .bt-hero-store {
      transition: none;
    }
  }

  .bt-hero-status {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin: 1.35rem 0 0;
    color: var(--bt-faint);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .bt-hero-status-dot {
    flex: none;
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.5em;
    border-radius: 999px;
    background: var(--bt-faint);
  }

  @media (max-width: 64rem) {
    .bt-hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }

    .bt-hero-copy {
      max-width: 42rem;
    }
  }

  @media (max-width: 48rem) {
    .bt-hero-actions :global(.sl-link-button) {
      padding-block: 0.7rem;
    }
  }
</style>
