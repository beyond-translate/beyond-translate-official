---
import { Globe } from '@lucide/astro';

import iconUrl from '@/assets/icon.svg';
import { getLanding } from '@/i18n/landing';

interface Props {
  lang?: string;
  class?: string;
}

const { lang, class: className } = Astro.props;
const copy = getLanding(lang);
const iconSrc = typeof iconUrl === 'string' ? iconUrl : iconUrl.src;
const [before, after = ''] = copy.preview.firstSource.split(copy.preview.selectedSource);
---

<div class:list={['bt-preview', className]} aria-hidden="true" data-pagefind-ignore>
  <div class="bt-preview-glow"></div>

  <div class="bt-browser">
    <div class="bt-browser-bar">
      <span class="bt-browser-dots">
        <i></i>
        <i></i>
        <i></i>
      </span>
      <span class="bt-url">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <rect x="3.5" y="7" width="9" height="6.5" rx="1.5"></rect>
          <path d="M5.5 7V5.5a2.5 2.5 0 0 1 5 0V7"></path>
        </svg>
        {copy.preview.url}
      </span>
      <span class="bt-toolbar">
        <img src={iconSrc} alt="" width="18" height="18" />
        <span class="bt-toolbar-badge">
          <span class="bt-toolbar-dot"></span>
          {copy.preview.translated}
        </span>
      </span>
    </div>

    <div class="bt-page">
      <header class="bt-article-head">
        <span class="bt-kicker">{copy.preview.sourceLabel}</span>
        <h3>{copy.preview.title}</h3>
        <p>{copy.preview.byline}</p>
      </header>

      <div class="bt-paragraph">
        <p class="bt-source">
          {before}
          <mark class="bt-mark">{copy.preview.selectedSource}</mark>
          {after}
        </p>
        <div class="bt-translation">
          <span class="bt-translation-label">{copy.preview.targetLabel}</span>
          <p>{copy.preview.firstTranslation}</p>
        </div>
      </div>

      <div class="bt-paragraph bt-paragraph-secondary">
        <p class="bt-source">{copy.preview.secondSource}</p>
        <div class="bt-translation">
          <span class="bt-translation-label">{copy.preview.targetLabel}</span>
          <p>{copy.preview.secondTranslation}</p>
        </div>
      </div>
    </div>

    <div class="bt-bubble">
      <div class="bt-bubble-head">
        <span>{copy.preview.bubbleLabel}</span>
        <span class="bt-bubble-modes">
          <span class="is-active">{copy.preview.bilingual}</span>
          <span>{copy.preview.translationOnly}</span>
        </span>
      </div>
      <p class="bt-bubble-text">{copy.preview.selectedTranslation}</p>
      <div class="bt-bubble-foot">
        <span class="bt-bubble-action">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M5.5 5.5h7v7h-7z"></path>
            <path d="M3.5 10.5v-7h7"></path>
          </svg>
        </span>
        <span class="bt-bubble-action">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M4 9.5V4h4.5L13 8.5 9.5 12z"></path>
            <path d="M2.5 11.5V14"></path>
          </svg>
        </span>
      </div>
    </div>

    <div class="bt-floatball">
      <Globe size={16} stroke-width={1.8} aria-hidden="true" />
      <span class="bt-floatball-dot"></span>
    </div>
  </div>
</div>

<style>
  .bt-preview {
    position: relative;
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
  }

  .bt-preview-glow {
    position: absolute;
    inset: 12% -4% 8%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, var(--bt-glow), transparent 68%);
    filter: blur(48px);
  }

  .bt-browser {
    position: relative;
    overflow: visible;
    border: 1px solid var(--bt-border-strong);
    border-radius: 1.1rem;
    background: var(--bt-surface);
    box-shadow: var(--bt-shadow);
    font-family: var(--bt-font-sans);
  }

  .bt-browser-bar {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    border-bottom: 1px solid var(--bt-border);
    padding: 0.65rem 0.8rem;
    background: color-mix(in oklab, var(--bt-surface-2) 55%, var(--bt-surface));
    border-radius: 1.1rem 1.1rem 0 0;
  }

  .bt-browser-dots {
    display: flex;
    flex: none;
    gap: 0.3rem;
  }

  .bt-browser-dots i {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 999px;
    background: var(--bt-border-strong);
  }

  .bt-browser-dots i:first-child {
    background: color-mix(in oklab, #ef4444 70%, var(--bt-border-strong));
  }

  .bt-browser-dots i:nth-child(2) {
    background: color-mix(in oklab, #f59e0b 70%, var(--bt-border-strong));
  }

  .bt-browser-dots i:last-child {
    background: color-mix(in oklab, #22c55e 70%, var(--bt-border-strong));
  }

  .bt-url {
    display: flex;
    min-width: 0;
    flex: 1;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--bt-border);
    border-radius: 999px;
    padding: 0.25rem 0.65rem;
    background: var(--bt-surface);
    color: var(--bt-faint);
    font-family: var(--bt-font-mono);
    font-size: 0.6rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bt-url svg {
    width: 0.7rem;
    height: 0.7rem;
    flex: none;
    opacity: 0.7;
  }

  .bt-toolbar {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.4rem;
  }

  .bt-toolbar img {
    border-radius: 0.3rem;
  }

  .bt-toolbar-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border: 1px solid color-mix(in oklab, var(--bt-brand) 30%, var(--bt-border));
    border-radius: 999px;
    padding: 0.12rem 0.45rem;
    background: var(--bt-brand-soft);
    color: var(--bt-brand);
    font-size: 0.56rem;
    font-weight: 600;
  }

  .bt-toolbar-dot {
    width: 0.3rem;
    height: 0.3rem;
    border-radius: 999px;
    background: #2563eb;
  }

  .bt-page {
    padding: 1.35rem 1.35rem 1.7rem;
    padding-inline-end: 13rem;
    background:
      linear-gradient(var(--bt-bg) 0 0) padding-box,
      radial-gradient(circle at 100% 0%, var(--bt-brand-soft), transparent 42%);
    border-radius: 0 0 1.1rem 1.1rem;
  }

  .bt-article-head {
    display: grid;
    gap: 0.2rem;
    border-bottom: 1px solid var(--bt-border);
    padding-bottom: 0.75rem;
  }

  .bt-kicker {
    color: var(--bt-brand);
    font-family: var(--bt-font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bt-article-head h3 {
    margin: 0;
    color: var(--bt-ink);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Georgia, 'Noto Serif CJK SC', serif;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .bt-article-head p {
    margin: 0;
    color: var(--bt-faint);
    font-size: 0.6rem;
  }

  .bt-paragraph {
    margin-top: 0.9rem;
  }

  .bt-source {
    margin: 0;
    color: var(--bt-ink);
    font-family: 'Iowan Old Style', 'Palatino Linotype', Georgia, 'Noto Serif CJK SC', serif;
    font-size: 0.78rem;
    line-height: 1.65;
  }

  .bt-mark {
    padding-bottom: 0.06em;
    background-color: transparent;
    background-image: linear-gradient(var(--bt-brand), var(--bt-brand));
    background-position: 0 100%;
    background-repeat: no-repeat;
    background-size: 100% 2px;
    color: inherit;
    animation: bt-mark-in 1.1s 0.4s ease-out both;
  }

  .bt-translation {
    margin-top: 0.55rem;
    border-inline-start: 2px solid color-mix(in oklab, var(--bt-brand) 65%, transparent);
    border-radius: 0 0.35rem 0.35rem 0;
    padding: 0.45rem 0.65rem;
    background: var(--bt-highlight);
  }

  .bt-translation-label {
    display: block;
    color: var(--bt-brand);
    font-family: var(--bt-font-mono);
    font-size: 0.48rem;
    letter-spacing: 0.05em;
  }

  .bt-translation p {
    margin: 0.15rem 0 0;
    color: var(--bt-ink);
    font-size: 0.7rem;
    line-height: 1.6;
  }

  .bt-paragraph-secondary {
    margin-top: 0.85rem;
  }

  .bt-bubble {
    position: absolute;
    top: 27%;
    right: 0.7rem;
    z-index: 2;
    width: min(11.75rem, 42%);
    border: 1px solid var(--bt-border-strong);
    border-radius: 0.85rem;
    padding: 0.65rem 0.7rem;
    background: color-mix(in oklab, var(--bt-surface) 96%, transparent);
    box-shadow: 0 18px 45px -18px rgb(0 0 0 / 35%);
    backdrop-filter: blur(14px);
    animation:
      bt-bubble-in 0.7s 0.9s ease-out both,
      bt-bubble-float 7s 1.8s ease-in-out infinite;
  }

  .bt-bubble::before {
    content: '';
    position: absolute;
    top: 1.25rem;
    left: -0.32rem;
    width: 0.6rem;
    height: 0.6rem;
    border-inline-start: 1px solid var(--bt-border-strong);
    border-block-end: 1px solid var(--bt-border-strong);
    background: var(--bt-surface);
    rotate: 45deg;
  }

  .bt-bubble-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--bt-muted);
    font-size: 0.55rem;
  }

  .bt-bubble-modes {
    display: flex;
    gap: 0.15rem;
    border: 1px solid var(--bt-border);
    border-radius: 999px;
    padding: 0.1rem;
    background: var(--bt-surface-2);
    font-size: 0.5rem;
  }

  .bt-bubble-modes span {
    border-radius: 999px;
    padding: 0.12rem 0.35rem;
    white-space: nowrap;
  }

  .bt-bubble-modes .is-active {
    background: var(--bt-brand);
    color: var(--bt-brand-ink);
  }

  .bt-bubble-text {
    margin: 0.55rem 0 0;
    color: var(--bt-ink);
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .bt-bubble-foot {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.55rem;
  }

  .bt-bubble-action {
    display: grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    border: 1px solid var(--bt-border);
    border-radius: 0.35rem;
    color: var(--bt-muted);
  }

  .bt-bubble-action svg {
    width: 0.65rem;
    height: 0.65rem;
  }

  .bt-floatball {
    position: absolute;
    right: -0.55rem;
    bottom: 1rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--bt-border);
    border-radius: 999px;
    background: var(--bt-surface);
    color: var(--bt-ink);
    box-shadow: 0 4px 14px -6px rgb(0 0 0 / 28%);
  }

  .bt-floatball-dot {
    position: absolute;
    top: -0.05rem;
    right: -0.05rem;
    width: 0.5rem;
    height: 0.5rem;
    border: 1.5px solid var(--bt-surface);
    border-radius: 999px;
    background: #2563eb;
  }

  @keyframes bt-mark-in {
    from {
      background-size: 0 2px;
    }
    to {
      background-size: 100% 2px;
    }
  }

  @keyframes bt-bubble-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes bt-bubble-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -5px;
    }
  }

  @media (max-width: 72rem) {
    .bt-preview {
      max-width: 30rem;
    }
  }

  @media (max-width: 72rem) {
    .bt-page {
      padding-inline-end: 1.35rem;
    }

    .bt-bubble {
      display: none;
    }
  }

  @media (max-width: 48rem) {
    .bt-page {
      padding: 1.1rem 1rem 1.35rem;
    }

    .bt-floatball {
      right: -0.35rem;
    }
  }

  @media (max-width: 40rem) {
    .bt-paragraph-secondary {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bt-mark,
    .bt-bubble {
      animation: none;
    }
  }
</style>
