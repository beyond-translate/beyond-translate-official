---
import { BookOpenText, MessageSquare, Rocket } from '@lucide/astro';

import SectionHeading from '@/components/landing/SectionHeading.astro';
import { storeIds, storeLogos, storeUrls } from '@/config/stores';
import { getLanding } from '@/i18n/landing';
import { helpPath } from '@/i18n/purchase';
import { withBase } from '@/lib/url';

interface Props {
  lang?: string;
}

const { lang } = Astro.props;
const copy = getLanding(lang);
const feedbackUrl = 'https://github.com/beyond-translate/feedback/issues';
const stores = storeIds.map((id, index) => ({
  label: copy.release.browsers[index] ?? id,
  href: storeUrls[id],
  logo: withBase(storeLogos[id]),
}));
---

<section id="release" class="bt-release" aria-labelledby="release-title">
  <SectionHeading
    id="release-title"
    index="04"
    kicker={copy.kickers.release}
    title={copy.release.heading}
    intro={copy.release.intro}
  />

  <div class="bt-release-panel">
    <div class="bt-release-copy">
      <span class="bt-release-icon" aria-hidden="true">
        <Rocket size={20} stroke-width={1.7} />
      </span>
      <p>{copy.release.body}</p>

      <div class="bt-browsers" aria-label={copy.release.notes}>
        {stores.map((store) => (
          <a class="bt-browser-chip" href={store.href} target="_blank" rel="noopener noreferrer">
            <img class="bt-browser-logo" src={store.logo} alt="" width="14" height="14" />
            {store.label}
          </a>
        ))}
      </div>
      <p class="bt-release-notes">{copy.release.notes}</p>
    </div>

    <div class="bt-release-actions">
      <a class="bt-release-action is-primary" href={feedbackUrl} target="_blank" rel="noopener noreferrer">
        <MessageSquare size={17} stroke-width={1.8} aria-hidden="true" />
        {copy.release.feedbackCta}
      </a>
      <a class="bt-release-action" href={withBase(helpPath(lang))}>
        <BookOpenText size={17} stroke-width={1.8} aria-hidden="true" />
        {copy.release.helpCta}
      </a>
    </div>
  </div>
</section>

<style>
  .bt-release {
    padding-block: var(--bt-space-section);
    border-top: 1px solid var(--bt-border);
  }

  .bt-release-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    border: 1px solid color-mix(in oklab, var(--bt-brand) 28%, var(--bt-border));
    border-radius: 1.15rem;
    padding: clamp(1.4rem, 3.5vw, 2.4rem);
    background:
      radial-gradient(circle at 0% 0%, var(--bt-brand-soft), transparent 45%),
      color-mix(in oklab, var(--bt-surface) 72%, transparent);
  }

  .bt-release-copy {
    display: grid;
    justify-items: start;
    gap: 0.8rem;
  }

  .bt-release-icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.7rem;
    background: var(--bt-brand);
    color: var(--bt-brand-ink);
  }

  .bt-release-copy > p {
    max-width: 36rem;
    margin: 0;
    color: var(--bt-muted);
    font-size: 0.9rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .bt-browsers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .bt-browser-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--bt-border);
    border-radius: 999px;
    padding: 0.28rem 0.6rem;
    background: var(--bt-surface);
    color: var(--bt-ink);
    font-size: 0.72rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 150ms ease,
      color 150ms ease,
      background-color 150ms ease;
  }

  .bt-browser-chip:hover {
    border-color: var(--bt-brand);
    background: var(--bt-brand-soft);
    color: var(--bt-brand);
  }

  .bt-browser-logo {
    display: block;
    width: 0.9rem;
    height: 0.9rem;
    object-fit: contain;
  }

  .bt-release-notes {
    margin: 0;
    color: var(--bt-faint);
    font-family: var(--bt-font-mono);
    font-size: 0.62rem;
  }

  .bt-release-actions {
    display: grid;
    gap: 0.55rem;
  }

  .bt-release-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 1px solid var(--bt-border-strong);
    border-radius: 999px;
    padding: 0.7rem 1rem;
    color: var(--bt-ink);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease;
  }

  .bt-release-action:hover {
    border-color: var(--bt-brand);
    color: var(--bt-brand);
  }

  .bt-release-action.is-primary {
    border-color: var(--bt-brand);
    background: var(--bt-brand);
    color: var(--bt-brand-ink);
  }

  .bt-release-action.is-primary:hover {
    border-color: var(--bt-brand-strong);
    background: var(--bt-brand-strong);
    color: var(--bt-brand-ink);
  }

  @media (max-width: 56rem) {
    .bt-release-panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .bt-release-actions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .bt-release-actions {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bt-release-action {
      transition: none;
    }
  }
</style>
